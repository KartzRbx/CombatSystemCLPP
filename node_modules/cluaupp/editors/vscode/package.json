{
	"name": "cluaupp-diagnostics",
	"displayName": "Cluaupp",
	"description": "Cluaupp project diagnostics. Language highlighting and IntelliSense come from clpp install (CL++).",
	"version": "1.4.0",
	"publisher": "kartzdev",
	"engines": {
		"vscode": "^1.74.0"
	},
	"categories": [
		"Linters"
	],
	"activationEvents": [
		"onLanguage:clpp"
	],
	"main": "./extension.js",
	"contributes": {
		"commands": [
			{
				"command": "cluaupp.restartIntelliSense",
				"title": "Cluaupp: Reload editor helper"
			}
		]
	}
}
