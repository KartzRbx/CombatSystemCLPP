// Asset reference (replaces several ContentId uses).
struct Content {
	Content();
	static Content fromUri(string uri);
	static Content fromAssetId(long long assetId);
};

// ContentId
struct ContentId {
	ContentId(string uri);
};

// SharedTable
struct SharedTable {
	SharedTable();
};

// Secret
struct Secret {
	Secret();
};

// Luau binary buffer. Library + type: buffer::create, buffer::writeu32, buffer::readf64.
struct buffer {
	buffer();
	static buffer create(int size);
	static buffer fromstring(string str);
	static string tostring(buffer b);
	static string tostring(buffer b, int offset);
	static string tostring(buffer b, int offset, int count);
	static int len(buffer b);
	static void copy(buffer target, int targetOffset, buffer source);
	static void copy(buffer target, int targetOffset, buffer source, int sourceOffset);
	static void copy(buffer target, int targetOffset, buffer source, int sourceOffset, int count);
	static void fill(buffer b, int offset, int value);
	static void fill(buffer b, int offset, int value, int count);
	static int readi8(buffer b, int offset);
	static int readu8(buffer b, int offset);
	static int readi16(buffer b, int offset);
	static int readu16(buffer b, int offset);
	static int readi32(buffer b, int offset);
	static int readu32(buffer b, int offset);
	static double readf32(buffer b, int offset);
	static double readf64(buffer b, int offset);
	static string readstring(buffer b, int offset, int count);
	static int readbits(buffer b, int bitOffset, int bitCount);
	static void writei8(buffer b, int offset, int value);
	static void writeu8(buffer b, int offset, int value);
	static void writei16(buffer b, int offset, int value);
	static void writeu16(buffer b, int offset, int value);
	static void writei32(buffer b, int offset, int value);
	static void writeu32(buffer b, int offset, int value);
	static void writef32(buffer b, int offset, double value);
	static void writef64(buffer b, int offset, double value);
	static void writestring(buffer b, int offset, string value);
	static void writestring(buffer b, int offset, string value, int count);
	static void writebits(buffer b, int bitOffset, int bitCount, int value);
};

