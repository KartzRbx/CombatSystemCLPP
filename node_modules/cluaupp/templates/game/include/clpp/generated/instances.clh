	Attachment Attachment0;
	Attachment Attachment1;
	::BrickColor Color;
	bool Enabled;
	bool Visible;
	::Vector3 GetDebugAppliedForce(int bodyId);
	::Vector3 GetDebugAppliedTorque(int bodyId);
	bool Archivable;
	string Attributes;
	string AttributesReplicate;
	string AttributesSerialize;
	::SecurityCapabilities Capabilities;
	int DataCost;
	bool DefinesCapabilities;
	::UniqueId HistoryId;
	bool IsInSandbox;
	string Name;
	Instance Parent;
	Enum::PredictionMode PredictionMode;
	Enum::PropertyStatus PropertyStatusStudio;
	bool RobloxLocked;
	bool Sandboxed;
	string SerializedOverrides;
	long long SourceAssetId;
	string Tags;
	::UniqueId UniqueId;
	bool archivable;
	int numExpectedDirectChildren;
	void AddTag(string tag);
	void ClearAllChildren();
	Instance Clone();
	void Destroy();
	Instance FindFirstAncestor(string name);
	Instance FindFirstAncestorOfClass(string className);
	Instance FindFirstAncestorWhichIsA(string className);
	Instance FindFirstChild(string name, bool recursive = false);
	Instance FindFirstChildOfClass(string className);
	Instance FindFirstChildWhichIsA(string className, bool recursive = false);
	Instance FindFirstDescendant(string name);
	Actor GetActor();
	void* GetAttribute(string attribute);
	::RBXScriptSignal GetAttributeChangedSignal(string attribute);
	void* GetAttributes();
	LuaArray<Instance> GetChildren();
	string GetDebugId(int scopeLength = 4);
	LuaArray<Instance> GetDescendants();
	string GetFullName();
	void* GetStyled(string name, string selector);
	::RBXScriptSignal GetStyledPropertyChangedSignal(string property);
	void* GetTags();
	bool HasTag(string tag);
	bool IsAncestorOf(Instance descendant);
	bool IsDescendantOf(Instance ancestor);
	bool IsPropertyModified(string property);
	LuaArray<Instance> QueryDescendants(string selector);
	void Remove();
	void RemoveTag(string tag);
	void ResetPropertyToDefault(string property);
	void SetAttribute(string attribute, void* value);
	Instance WaitForChild(string childName);
	Instance WaitForChild(string childName, double timeOut);
	LuaArray<Instance> children();
	Instance clone();
	void destroy();
	Instance findFirstChild(string name, bool recursive = false);
	LuaArray<Instance> getChildren();
	bool isDescendantOf(Instance ancestor);
	void remove();
	RBXScriptSignal AncestryChanged;
	RBXScriptSignal AttributeChanged;
	RBXScriptSignal ChildAdded;
	RBXScriptSignal ChildRemoved;
	RBXScriptSignal DescendantAdded;
	RBXScriptSignal DescendantRemoving;
	RBXScriptSignal Destroying;
	RBXScriptSignal StyledPropertiesChanged;
	RBXScriptSignal childAdded;
	string ClassName;
	string className;
	::RBXScriptSignal GetPropertyChangedSignal(string property);
	bool IsA(string className);
	bool isA(string className);
	RBXScriptSignal Changed;
};

