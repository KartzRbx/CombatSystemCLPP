	long long SourceUniverseId;
	string ClassName;
	string className;
	::RBXScriptSignal GetPropertyChangedSignal(string property);
	bool IsA(string className);
	bool isA(string className);
	RBXScriptSignal Changed;
};

struct ConfigSnapshot : Object {
	Enum::ConfigSnapshotErrorState Error;
	bool Outdated;
	void* GetValue(string key);
	::RBXScriptSignal GetValueChangedSignal(string key);
	void Refresh();
	RBXScriptSignal UpdateAvailable;
	string ClassName;
	string className;
	::RBXScriptSignal GetPropertyChangedSignal(string property);
	bool IsA(string className);
	bool isA(string className);
	RBXScriptSignal Changed;
};

struct DataModelDiff : Object {
	Enum::DataModelChangeType GetChangeType(::ScopedInstanceIdentity identity);
	void* GetIdentities();
	void* GetPropertyNames(::ScopedInstanceIdentity identity);
	string ClassName;
	string className;
	::RBXScriptSignal GetPropertyChangedSignal(string property);
	bool IsA(string className);
	bool isA(string className);
	RBXScriptSignal Changed;
};

struct EditableImage : Object {
	string ImageData;
	::NetAssetRef ImageHolder;
	bool IsReplicatedCopy;
	::Vector2 Size;
	void Destroy();
	void DrawCircle(::Vector2 center, int radius, ::Color3 color, float transparency, Enum::ImageCombineType combineType, Enum::AntiAliasing antiAliasing);
	void DrawImage(::Vector2 position, EditableImage image, Enum::ImageCombineType combineType);
	void DrawImageProjected(EditableMesh mesh, void* projection, void* brushConfig);
	void DrawImageTransformed(::Vector2 position, ::Vector2 scale, float rotation, EditableImage image, void* options);
	void DrawLine(::Vector2 p1, ::Vector2 p2, ::Color3 color, float transparency, Enum::ImageCombineType combineType, Enum::AntiAliasing antiAliasing);
	void DrawRectangle(::Vector2 position, ::Vector2 size, ::Color3 color, float transparency, Enum::ImageCombineType combineType);
	void DrawTriangle(::Vector2 p1, ::Vector2 p2, ::Vector2 p3, ::Color3 color, float transparency);
	::buffer ReadPixelsBuffer(::Vector2 position, ::Vector2 size);
	void SampleImageProjected(EditableMesh sourceMesh, EditableImage sourceTexture, void* projectionConfig, void* brushConfig);
	void WritePixelsBuffer(::Vector2 position, ::Vector2 size, ::buffer buffer);
	string ClassName;
	string className;
	::RBXScriptSignal GetPropertyChangedSignal(string property);
	bool IsA(string className);
	bool isA(string className);
	RBXScriptSignal Changed;
};

struct EditableMesh : Object {
	::NetAssetRef EditableMeshDataHolder;
	bool FixedSize;
	bool IsReplicatedCopy;
	string MeshData;
	long long AddBone(void* boneProperties);
	long long AddColor(::Color3 color, float alpha);
	long long AddFace(void* vertexIds);
	long long AddNormal(::Vector3 normal);
