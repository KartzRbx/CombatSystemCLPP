struct Object {
	Object() = default;
	string ClassName;
	string className;
	::RBXScriptSignal GetPropertyChangedSignal(string property);
	bool IsA(string className);
	bool isA(string className);
	RBXScriptSignal Changed;
};

struct AnimatedImageTrack : Object {
	float Duration;
	int FrameCount;
	string TrackName;
	::Content GetContent();
	void* GetFrameNames();
	string ClassName;
	string className;
	::RBXScriptSignal GetPropertyChangedSignal(string property);
	bool IsA(string className);
	bool isA(string className);
	RBXScriptSignal Changed;
};

struct AnimationNode : Object {
	string ClassName;
	string className;
	::RBXScriptSignal GetPropertyChangedSignal(string property);
	bool IsA(string className);
	bool isA(string className);
	RBXScriptSignal Changed;
};

struct Capture : Object {
	::DateTime CaptureTime;
	Enum::CaptureType CaptureType;
	string FilePathString;
	string LocalId;
	long long SourcePlaceId;
	long long SourceUniverseId;
	string ClassName;
	string className;
	::RBXScriptSignal GetPropertyChangedSignal(string property);
	bool IsA(string className);
	bool isA(string className);
	RBXScriptSignal Changed;
};

