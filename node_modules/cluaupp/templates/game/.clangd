CompileFlags:
  CompilationDatabase: .
  Add:
    - -xc++
    - -std=c++20
    - -ferror-limit=0
    - -Iinclude
    - -Isrc
    - -I../../include

Diagnostics:
  Suppress: '*'

---
If:
  PathMatch: .*\.(cpp|cc|cxx|c|h|hpp|hh)$
CompileFlags:
  Add:
    - -xc++

---
If:
  PathMatch: (out|libs)/.*
Index:
  Background: Skip
